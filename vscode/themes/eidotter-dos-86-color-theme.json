    "terminal.ansiBrightRed": "#FF8888",
    "terminal.ansiBrightGreen": "#55FF55",
    "terminal.ansiBrightYellow": "#FFFF99",
    "terminal.ansiBrightBlue": "#9999FF",
    "terminal.ansiBrightMagenta": "#FF9AFF",
    "terminal.ansiBrightCyan": "#55FFFF",
    "terminal.ansiBrightWhite": "#FFFCF7",
