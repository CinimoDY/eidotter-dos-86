  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#B87C1A",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword, storage",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#FFB000"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#FFB000"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#FFB000"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#FDCA9F"
      }
    },
    {
      "name": "Number, constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant"
      ],
      "settings": {
        "foreground": "#FDCA9F"
      }
    },
    {
      "name": "Function, class name",
      "scope": [
        "entity.name.function",
        "support.function",
        "entity.name.class",
        "meta.function-call entity.name.function"
      ],
      "settings": {
        "foreground": "#FDCA9F"
      }
    },
    {
      "name": "Variable, property",
      "scope": [
        "variable",
        "variable.other",
        "variable.parameter",
        "meta.object-literal.key",
        "support.variable.property"
      ],
      "settings": {
        "foreground": "#FFB000"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#FDCA9F"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FFB000"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#B87C1A"
      }
    },
    {
      "name": "String delimiters",
      "scope": [
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#FDCA9F"
      }
    },
    {
      "name": "Escape, regex",
      "scope": [
        "constant.character.escape",
        "string.regexp",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#FF55FF"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#FF5555"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#FFFF55"
      }
    },
    {
      "name": "Diff inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "#55FF55"
      }
    },
    {
      "name": "Diff deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "#FF5555"
      }
    },
    {
      "name": "Diff changed",
      "scope": [
        "markup.changed",
        "meta.diff.range"
      ],
      "settings": {
        "foreground": "#00AAAA"
      }
    },
    {
      "name": "Markdown heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#FDCA9F",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#FDCA9F",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#FFB000",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#9999FF"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#FDCA9F"
      }
    },
    {
      "name": "Markdown quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#B87C1A",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticTokenColors": {
    "comment": {
      "foreground": "#B87C1A",
      "italic": true
    },
    "keyword": "#FFB000",
    "type": "#FFB000",
    "class": "#FDCA9F",
    "interface": "#FFB000",
    "enum": "#FFB000",
    "function": "#FDCA9F",
    "method": "#FDCA9F",
    "string": "#FDCA9F",
    "number": "#FDCA9F",
    "regexp": "#FF55FF",
    "variable": "#FFB000",
    "variable.readonly": "#FDCA9F",
    "parameter": "#FFB000",
    "property": "#FFB000",
    "property.readonly": "#FDCA9F",
    "enumMember": "#FDCA9F",
    "*.deprecated": {
      "strikethrough": true
    }
  }
}
